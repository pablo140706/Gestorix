# Copia este archivo como ".env" y pon tus propios valores.
# El ".env" nunca va a git (está en .gitignore); este ejemplo sí.

# Base de datos. Este usuario es el administrador: lo usas en pgAdmin.
POSTGRES_DB=gestorix
POSTGRES_USER=gestorix_admin
POSTGRES_PASSWORD=cambia-esta-contrasena

# Usuario con el que entra la app: solo lee y escribe datos, no cambia tablas.
APP_DB_USER=gestorix_app
APP_DB_PASSWORD=cambia-esta-otra

# pgAdmin (http://localhost:5050)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=cambia-esta-tambien

# Dirección de la app, para los enlaces de los correos de verificación.
# En la PC con ngrok es la dirección que te da ngrok, con https.
APP_URL=http://localhost:8080

# Correo (Gmail). SMTP_PASSWORD es una "contraseña de aplicación" de Google
# (myaccount.google.com/apppasswords, 16 letras sin espacios), no la normal.
# Si falta alguno, los correos no se mandan: salen en "docker compose logs web".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Gestorix
